// Prisma schema for FREE-STU — 免費 AI 學習站（自架單人版，BYOK）。
// 表：UserKey（主 key＋視覺 key）/ Note / Generation（result 存 JSON、options 存設定快照）/ Usage（token 記賬）。

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UserKey {
  id        String   @id @default("default")
  provider  String   @default("openai")
  baseUrl   String   @default("https://api.openai.com/v1")
  model     String   @default("gpt-4o-mini")
  apiKey    String
  visionProvider String?
  visionBaseUrl  String?
  visionModel    String?
  visionApiKey   String?
  systemPrompt String   @default("")
  updatedAt DateTime @updatedAt
}

model Note {
  id          String       @id @default(cuid())
  title       String       @default("未命名筆記")
  rawText     String
  tags        String       @default("")
  createdAt   DateTime     @default(now())
  generations Generation[]
  studyPlans  StudyPlan[]
}

model Generation {
  id        String   @id @default(cuid())
  type      String
  status    String   @default("pending")
  result    String?
  error     String?
  options   String   @default("{}")
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Usage {
  id               String   @id @default(cuid())
  kind             String
  model            String   @default("")
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  createdAt        DateTime @default(now())
}

model CustomTemplate {
  id        String   @id @default(cuid())
  name      String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** 作答紀錄：信心標記（high/med/low）× 對錯 → 盲點分析＋複習佇列的地基 */
model Attempt {
  id         String   @id @default(cuid())
  genId      String
  noteId     String
  kind       String   @default("quiz")
  qIndex     Int
  picked     Int?
  correct    Boolean
  confidence String   @default("med")
  createdAt  DateTime @default(now())

  @@index([noteId, createdAt])
}

/** 雙向來源追蹤：每個段落 pN 被哪些產出引用（flashcard/quiz/mindmap/podcast/chat） */
model UsageLink {
  id      String @id @default(cuid())
  noteId  String
  paraId  String
  genId   String?
  kind    String
  ref     String?
  createdAt DateTime @default(now())

  @@index([noteId, paraId])
  @@index([genId])
}

/** 學習計畫：AI 生成的每日學習排程（主題拆解 + 每天要複習的段落） */
model StudyPlan {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  days      Int
  difficulty String  @default("medium")
  result    String?
  status    String   @default("pending")
  error     String?
  createdAt DateTime @default(now())

  @@index([noteId, createdAt])
}

/**
 * 複習卡：排程持久化（A2；T3-2 走四檔 SM-2 增量狀態）。
 * - key = (genId, qIndex) 唯一，一題一行；qIndex 越界的作答不建卡（quarantine）。
 * - intervalDays（Float，Again 可到 0.007 天）/ ease / streak / lapses / reviewCount 由
 *   server/review/queue 的 scheduleSm2(state, rating) 增量算出，attempt.log 每次作答 upsert。
 *   冷啟動預設 interval=1 / ease=2.5；rating 由 confidence→ratingOf 映射。
 * - 沒有 FK（Generation 刪除時不清卡，queue 用 lazy backfill 過濾已刪的 gen；Note 刪除時 note router 主動清卡）。
 * - 題目文字快照在 question（生成物被刪還能顯示；lazy backfill 時寫入）。
 */
model ReviewCard {
  id           String   @id @default(cuid())
  genId        String
  noteId       String
  kind         String   @default("quiz")
  qIndex       Int
  question     String   @default("")
  intervalDays Float    @default(0)
  ease         Float    @default(2.5)
  streak       Int      @default(0)
  reviewCount  Int      @default(0)
  dueAt        DateTime @default(now())
  lapses       Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([genId, qIndex])
  @@index([dueAt])
  @@index([noteId])
}
