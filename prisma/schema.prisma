// Prisma schema for FREE-STU — 免費 AI 學習站（自架單人版，BYOK）。
// 表：UserKey（主 key＋視覺 key）/ Note / Generation（result 存 JSON、options 存設定快照）/ Usage（token 記賬）。

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UserKey {
  id        String   @id @default("default")
  provider  String   @default("openai")
  baseUrl   String   @default("https://api.openai.com/v1")
  model     String   @default("gpt-4o-mini")
  apiKey    String
  visionProvider String?
  visionBaseUrl  String?
  visionModel    String?
  visionApiKey   String?
  systemPrompt String   @default("")
  updatedAt DateTime @updatedAt
}

model Note {
  id          String       @id @default(cuid())
  title       String       @default("未命名筆記")
  rawText     String
  createdAt   DateTime     @default(now())
  generations Generation[]
  studyPlans  StudyPlan[]
}

model Generation {
  id        String   @id @default(cuid())
  type      String
  status    String   @default("pending")
  result    String?
  error     String?
  options   String   @default("{}")
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Usage {
  id               String   @id @default(cuid())
  kind             String
  model            String   @default("")
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  createdAt        DateTime @default(now())
}

model CustomTemplate {
  id        String   @id @default(cuid())
  name      String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** 作答紀錄：信心標記（high/med/low）× 對錯 → 盲點分析＋複習佇列的地基 */
model Attempt {
  id         String   @id @default(cuid())
  genId      String
  noteId     String
  kind       String   @default("quiz")
  qIndex     Int
  picked     Int?
  correct    Boolean
  confidence String   @default("med")
  createdAt  DateTime @default(now())

  @@index([noteId, createdAt])
}

/** 雙向來源追蹤：每個段落 pN 被哪些產出引用（flashcard/quiz/mindmap/podcast/chat） */
model UsageLink {
  id      String @id @default(cuid())
  noteId  String
  paraId  String
  genId   String?
  kind    String
  ref     String?
  createdAt DateTime @default(now())

  @@index([noteId, paraId])
  @@index([genId])
}

/** 學習計畫：AI 生成的每日學習排程（主題拆解 + 每天要複習的段落） */
model StudyPlan {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  days      Int
  difficulty String  @default("medium")
  result    String?
  status    String   @default("pending")
  error     String?
  createdAt DateTime @default(now())

  @@index([noteId, createdAt])
}
